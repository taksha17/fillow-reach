# --- fillow Reach — add these to the fillow root .env ---
REACH_DRY_RUN=true
# App password for YOUR mailbox; fillow's GMAIL_IMAP_USER/GMAIL_APP_PASSWORD are the fallback
REACH_MAIL_USER=
REACH_MAIL_PASSWORD=
# Optional enrichment providers (monthly_quota 0 = disabled until you set your plan's quota):
HUNTER_API_KEY=
APOLLO_API_KEY=
# Optional local Qwen 1.5B GGUF for drafts when Groq/NIM keys are unset (~1GB download, ~1.5GB RAM)
REACH_LLM_GGUF=
REACH_LLM_URL=
