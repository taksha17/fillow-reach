{
  "name": "fillow-reach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "fillow Reach — recruiter outreach: find people, draft follow-ups, track the funnel",
  "bin": {
    "fillow-reach": "./bin/reach.mjs",
    "reach": "./bin/reach.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node bin/reach.mjs ui",
    "ui": "node bin/reach.mjs ui",
    "run": "node bin/reach.mjs run",
    "reach": "node bin/reach.mjs",
    "setup": "node bin/reach.mjs setup",
    "doctor": "node bin/reach.mjs doctor --no-mail",
    "status": "node bin/reach.mjs status",
    "lint": "node --check bin/reach.mjs && node --check lib/reach/cli.mjs && node --check lib/reach/run.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.mjs"
  },
  "keywords": [
    "fillow",
    "outreach",
    "recruiting",
    "linkedin",
    "sqlite"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "nodemailer": "^7.0.13"
  }
}
